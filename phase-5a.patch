+            new InvestigationRound[]{new InvestigationRound(1,"تصريح فتح القبة","سجل القبة يؤكد أنها فُتحت بتصريح يدوي فردي، وليس عبر البرنامج الآلي المعتاد الذي يتطلب موافقة اثنين.","","من يملك صلاحية فتح القبة بمفرده دون موافقة ثانية؟"),new InvestigationRound(2,"إشارة الاستغاثة المحذوفة","قسم من سجل جهاز التتبع يظهر أن إشارة استغاثة قصيرة أُرسلت ثم حُذفت خلال أقل من دقيقة واحدة من الجهاز نفسه.","","من كان يملك إمكانية الوصول الفوري لحذف إشارة بهذه السرعة؟"),new InvestigationRound(3,"الغبار في غرفة الصيانة","الغبار النيزكي الذي وُجد على مقبض غرفة الصيانة من نوع نادر يطابق تركيب العينة المفقودة تمامًا، لا غبار المنطقة المحيطة بالمرصد.","","من كان في غرفة الصيانة بعد اختفاء العينة مباشرة؟")}));
         stories.add(new Story("desert_archive", "أرشيف الرمال", "مخطوطة تقود إلى مدينة مطمورة اختفت من أرشيف بعثة صحراوية قبل انطلاق القافلة فجراً.", 4, 12,
             new StoryIntroduction("في مخيم بعثة أثرية وسط الصحراء الكبرى، حيث يقضي الفريق أسبوعه الأخير قبل انطلاق القافلة نحو مدينة مطمورة يُعتقد أن المخطوطة تقود إليها.","الليلة هي آخر ليلة قبل الرحيل، وصندوق المخطوطة محفوظ في خيمة الأرشيف المركزية تحت حراسة مشددة.","عند الفجر اكتُشف أن ختم صندوق المخطوطة أُعيد تركيبه بشمع مطابق لكن بطباعة مختلفة، وتوقف مولد الكهرباء ثلاث دقائق قبيل ذلك.","بدون المخطوطة الأصلية قد تضيع البعثة بأكملها في الرمال دون وجهة، وسنوات من البحث تذهب هباءً.","قبل أن تتحرك القافلة مع شروق الشمس، اكشفوا من عبث بالختم ومن يعرف طريق المدينة المفقودة أكثر مما يدّعي."),
             new StoryCharacter[]{new StoryCharacter("سلطان","خبير النقوش","أنت من فك رموز المخطوطة الأصلية، وتعرف تفاصيلها أكثر من أي شخص آخر في البعثة.","أنت من فتح الصندوق وأعاد ختمه بشمع مطابق لتنسخ صفحاتها الأخيرة لنفسك.","تعرف أن الشمع الأصلي يحتاج قالبًا نادرًا لا يملكه غيرك في المخيم.","كنت أراجع ترجمتي الأخيرة في خيمتي حتى وقت متأخر من الليل.","اجعل الجميع يظنون أن الرياح أو الرطوبة هي من أثّرت على الختم.",true,"احتفظ بنسخة الصفحات الأخيرة سرًا دون أن يلاحظ أحد نقصانها من الصندوق."),new StoryCharacter("فيصل","مساح الخرائط","ترسم مسار القافلة اعتمادًا على إحداثيات المخطوطة والنجوم.","وضعت خريطة قديمة مقلوبة عمدًا داخل خيمة المسح لتضليل من يبحث عن الاتجاه الصحيح.","تعرف أن سلطان طلب منك تأخير موعد الانطلاق ساعة كاملة دون سبب واضح.","كنت أراجع النجوم لتحديد الاتجاه الصحيح في الخارج طوال الليل.","أخفِ طلب سلطان الغريب حتى لا يُشتبه بكما معًا.",true,"أبقِ الخريطة الحقيقية بعيدة عن الآخرين حتى يغادر سلطان بما أخذه."),new StoryCharacter("جابر","دليل الصحراء","تعرف كل واحة وممر في هذه المنطقة، وأنت من يقود القافلة فعليًا.","ساعدت سلطان بإطفاء المولد ثلاث دقائق لتغطية صوت فتح الصندوق.","تعرف أن آثار الأحذية المتجهة نحو البئر تعود لك أنت، لأنك ذهبت لتتأكد أن أحدًا لم يرَ شيئًا.","كنت أتفقد الجمال والمياه استعدادًا للرحيل الفجري.","لا تدع أحدًا يسأل عن سبب انقطاع الكهرباء المفاجئ.",true,"امحُ آثار أقدامك قرب البئر قبل أن يلاحظها أحد في ضوء النهار.")},
             new StoryCharacter[]{new StoryCharacter("سعاد","أمينة الأرشيف","المسؤولة الرسمية عن حفظ المخطوطة وكل وثائق البعثة.","أخفيت عن قائد البعثة أنك فقدت مفتاح الصندوق الاحتياطي منذ أسبوع.","تعرفين أن صندوق المخطوطة لا يُفتح إلا بالمفتاح الأصلي أو الاحتياطي، وكلاهما كان معك أنتِ نظريًا.","كنت أرتب أوراق البعثة في خيمتي قبل الفجر مباشرة.","أخفي فقدان المفتاح حتى لا تُتهمي بالتقصير في أول مهمة كبيرة لك.",false,""),new StoryCharacter("رشا","طبيبة البعثة","تراقبين صحة أفراد الفريق في ظروف الصحراء القاسية.","أعطيتِ سلطان مسكنًا قويًا لصداع مفاجئ في وقت متأخر من الليل دون أن تسألي عن السبب.","تعرفين أن سلطان بدا متوترًا بشكل غير معتاد في الساعة الأخيرة قبل الحادث.","كنت في خيمة الإسعافات أُعدّ حقيبة الطوارئ لرحلة الغد.","حافظي على سرية زيارة سلطان الطبية حتى تعرفي إن كانت مرتبطة بالحادث.",false,""),new StoryCharacter("طلال","خبير النقوش المساعد","تعمل مع سلطان على فك رموز إضافية في هوامش المخطوطة.","اكتشفت خطأ في ترجمة سلطان السابقة ولم تخبره حتى لا تُحرجه أمام البعثة.","تعرف أن بعض العلامات في الخريطة لا تطابق الترجمة الرسمية التي أعلنها سلطان.","كنت أراجع ملاحظاتي الخاصة بعيدًا عن خيمة الأرشيف الرئيسية.","أخفِ شكوكك حول ترجمة سلطان حتى تجد دليلًا أوضح.",false,""),new StoryCharacter("منيرة","سائقة القافلة","تدير الجمال والمركبات وتحدد ترتيب السير في الصحراء.","غيّرتِ ترتيب حمولة المركبات في اللحظة الأخيرة لتوفير مساحة لأمتعة شخصية.","تعرفين أن جابر ابتعد عن مكان الجمال لفترة أطول من المعتاد أثناء انقطاع الكهرباء.","كنت أتحقق من رباط الأحمال قبل موعد الانطلاق مباشرة.","أخفي تغيير الحمولة حتى لا يبدو الأمر وكأنه محاولة لإخفاء شيء.",false,""),new StoryCharacter("عمار","مهندس المولد","مسؤول عن صيانة مولد الكهرباء الوحيد في المخيم.","تعرف أن المولد يعاني عطلًا متكررًا منذ أسبوعين، لكنك أخفيته لتفادي تأخير البعثة.","تعرف أن توقف المولد ثلاث دقائق قد يكون متعمدًا وليس عطلًا، لأن العطل المعتاد يستمر أطول.","كنت أراقب مؤشرات المولد من كوخه الصغير طوال الليل.","أخفِ عطل المولد المزمن حتى تصلحه بهدوء بعد وصول البعثة.",false,""),new StoryCharacter("ليث","حارس المخيم","يراقب محيط المخيم ليلًا لحماية الفريق من مخاطر الصحراء.","ابتعدت عن نقطة حراستك المعتادة لمساعدة أحد الأفراد في مهمة عاجلة لم تُعلن رسميًا.","تعرف أن جابر عاد إلى المخيم من جهة البئر في وقت غير معتاد لخروجه.","كنت أراقب الأفق من أعلى نقطة في المخيم طوال الليل.","أخفِ سبب ابتعادك عن نقطة الحراسة حتى لا يُشكك أحد في التزامك.",false,"")},
             new Clue[]{new Clue("ختم صندوق المخطوطة أعيد تركيبه بالشمع نفسه، لكن بطباعة مختلفة."),new Clue("خريطة قديمة وُضعت مقلوبة داخل خيمة المسح."),new Clue("سجل مولد الكهرباء يتوقف لمدة ثلاث دقائق قبل الفجر."),new Clue("آثار أحذية تتجه إلى البئر ثم تختفي عند الحافة.")},
