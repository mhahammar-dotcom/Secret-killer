+            new InvestigationRound[]{new InvestigationRound(1,"طباعة الختم المختلفة","فحص دقيق لختم الصندوق يُظهر أن الشمع الجديد من النوع نفسه، لكن طباعته أخف قليلاً، كأن القالب استُخدم بعد فترة راحة طويلة لا وقت قصير.","","من في المخيم يملك قالب ختم مطابق لهذا الاستخدام؟"),new InvestigationRound(2,"انقطاع المولد","سجل المولد يظهر أن انقطاعه لثلاث دقائق حدث يدويًا من لوحة التحكم، لا نتيجة عطل في الوقود أو المحرك.","","من كان بالقرب من كوخ المولد في تلك الدقائق الثلاث؟"),new InvestigationRound(3,"آثار الأقدام عند البئر","آثار الأحذية المتجهة إلى البئر تعود إلى حذاء عمل صحراوي ثقيل، من النوع الذي يرتديه أدلاء القافلة أكثر من باحثي الأرشيف.","","من في البعثة يرتدي هذا النوع من الأحذية الثقيلة؟")}));
         stories.add(new Story("drowned_village", "قرية تحت الماء", "خلال بعثة غوص إلى قرية غمرها السد، فُقد صندوق أجراس أثري من داخل المدرسة القديمة.", 4, 12,
             new StoryIntroduction("تحت سطح بحيرة سد قديم، تغوص بعثة صغيرة نحو قرية غارقة منذ عقود، حيث لا تزال المدرسة ومبانيها قائمة بين الطين والصمت.","اليوم هو يوم الغوص الأخير قبل إغلاق نافذة الطقس المناسبة، وصندوق أجراس المدرسة الأثري هو الهدف الرئيسي للبعثة.","عاد فريق الغوص ليجد أن حبل الرفع قُطع بأداة حادة، وأن صندوق الأجراس اختفى رغم أن أحدًا لم يدخل الماء قبل الفريق الرسمي.","الصندوق قطعة تاريخية نادرة تمثل آخر أثر لأهل القرية الأصليين، وفقدانه يعني ضياع جزء من تاريخهم إلى الأبد.","قبل أن يغلق موسم الغوص، اكتشفوا من نزل إلى الماء قبل الفريق الرسمي ولماذا."),
             new StoryCharacter[]{new StoryCharacter("رامز","غواص الإنقاذ","مهمتك تأمين حبال الغوص وإنقاذ أي غواص يتعرض لمشكلة تحت الماء.","أنت من قطع حبل الرفع لتأخذ الصندوق قبل أن يصعد الفريق الرسمي به.","تعرف بالضبط كيف تبدو أداة القطع الحادة تحت الماء دون ترك أثر واضح للعين غير المدربة.","كنت أراجع معدات الطوارئ على متن القارب طوال فترة الغوص.","اجعل الجميع يظنون أن ضغط الماء هو من أتلف الحبل.",true,"أخرج الصندوق من موقع الغوص دون أن يلاحظ أحد أنك نزلت إلى الماء قبل الفريق."),new StoryCharacter("سهيلة","مصورة الأعماق","توثقين البعثة بكاميرا مقاومة للماء لأرشيف تاريخي رسمي.","غطّيتِ على رامز بتسجيل مشاهد مضللة تُظهر الحبل سليمًا في وقت لاحق لقطعه فعليًا.","تعرفين أن الظل الذي مر أمام نافذة المدرسة في تسجيلك هو رامز، لكنك لم تخبري أحدًا.","كنت أصور واجهة المدرسة الغارقة من زاوية بعيدة عن الصندوق.","احمي رامز من الشك دون أن تعترفي بمعرفتك الحقيقية بما رأيتِه.",true,"لا تُظهري اللقطة الحقيقية للحبل قبل أن يغادر رامز بالصندوق بأمان."),new StoryCharacter("حاتم","مؤرخ القرية","تعرف تاريخ القرية الغارقة أكثر من أي شخص في البعثة، وأنت من اقترح موقع الصندوق بالتحديد.","ساعدت رامز بمعرفة الموقع الدقيق للصندوق داخل المدرسة مقابل حصة من قيمته التاريخية.","تعرف أن صوت الجرس الذي ظهر في التسجيل الصوتي غير ممكن إلا إذا فُتح الصندوق فعلًا تحت الماء.","كنت أراجع خرائط القرية القديمة على سطح القارب.","لا تدع أحدًا يعرف أنك حددت موقع الصندوق بدقة غير معتادة.",true,"أنكر أي معرفة مسبقة بمكان الصندوق داخل المدرسة.")},
             new StoryCharacter[]{new StoryCharacter("عبير","قائدة الغوص","المسؤولة الرسمية عن خطة الغوص وسلامة كل أفراد الفريق تحت الماء.","أخفيتِ عن الفريق أن تصريح الغوص الرسمي كان على وشك الانتهاء قبل يوم واحد فقط.","تعرفين أن أحدًا نزل إلى الماء قبل الموعد المحدد للفريق الرسمي، لأن معدات الأكسجين كانت ناقصة.","كنت أراجع خطة الغوص النهائية على متن القارب الرئيسي.","أخفي مشكلة التصريح حتى لا تُلغى البعثة بأكملها بسببك.",false,""),new StoryCharacter("كريستينا","عالمة الآثار","تشرفين على توثيق كل قطعة تُستخرج من القرية الغارقة علميًا.","طلبتِ من رامز فحص الصندوق أولًا قبل رفعه رسميًا دون علم بقية الفريق.","تعرفين أن الصندوق كان أخف وزنًا مما توقعتِ في آخر مرة لمسته قبل الحادث بيوم.","كنت أُعدّ أدوات التوثيق العلمي استعدادًا لرفع القطع الأثرية.","أخفي طلبك السابق من رامز حتى لا يبدو الأمر وكأنك ورطته.",false,""),new StoryCharacter("داود","مهندس السد","تراقب مستوى المياه وتيارات السد أثناء عمليات الغوص.","أخفيت عن الفريق أن مستوى المياه سيرتفع فجأة اليوم بسبب تصريف مجدول.","تعرف أن تيار الماء المفاجئ قد يكون حرك حبل الرفع دون تدخل بشري مباشر.","كنت أراقب لوحة تحكم السد من الكابينة الرئيسية طوال الوقت.","أخفِ معلومة التصريف المجدول حتى لا تُلام على توقيت البعثة الخاطئ.",false,""),new StoryCharacter("وداد","غواصة احتياطية","جاهزة للنزول في أي لحظة إذا احتاج الفريق الرئيسي دعمًا إضافيًا.","نزلتِ إلى الماء بمفردك لدقائق قصيرة دون إذن رسمي لاختبار معداتك الجديدة.","تعرفين أن رامز كان قريبًا من المدرسة في وقت غير مخطط له من جدول الغوص.","كنت أراجع معداتي على حافة القارب استعدادًا لأي طارئ.","أخفي نزولك غير المصرح به حتى لا تُوقفي عن العمل في البعثة.",false,""),new StoryCharacter("إياد","فني الأكسجين","يجهز أسطوانات الأكسجين ويتحقق من سلامتها قبل كل غوصة.","لاحظت نقصًا في عدد الأسطوانات المسجلة قبل الغوصة الأخيرة ولم تبلغ أحدًا.","تعرف أن أسطوانة إضافية استُخدمت في وقت لم يكن مجدولًا فيه أي غوص.","كنت أتحقق من ضغط الأسطوانات على متن القارب طوال الصباح.","أخفِ نقص الأسطوانات حتى تتأكد من أنه لم يكن خطأك في العد.",false,""),new StoryCharacter("سلافة","مساعدة التوثيق","تسجل كل قطعة تُستخرج من الموقع في سجل البعثة الرسمي.","أخطأتِ في تسجيل وزن الصندوق قبل الغوصة الأخيرة، وتخشين أن يُكتشف الخطأ.","تعرفين أن أحدًا طلب منك تأخير تسجيل الصندوق رسميًا حتى نهاية اليوم.","كنت أراجع سجلات القطع المستخرجة سابقًا في خيمة التوثيق.","أخفي خطأك في التسجيل حتى تصححيه دون أن يلاحظه أحد.",false,"")},
             new Clue[]{new Clue("كاميرا الأعماق سجّلت ظلاً يمر أمام النافذة قبل وصول الفريق."),new Clue("حبل الرفع قُطع بأداة حادة لا بضغط الماء."),new Clue("صوت جرس واحد ظهر في التسجيل الصوتي رغم أن الصندوق كان مغلقاً."),new Clue("خريطة الغوص الورقية تحتوي على علامة جديدة قرب بيت العمدة.")},
