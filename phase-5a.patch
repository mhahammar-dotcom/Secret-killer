+            new InvestigationRound[]{new InvestigationRound(1,"فارق الدقائق الخمس","سجل المفاتيح الورقي يظهر أن مفتاح غرفة الأدلة أُعيد إلى مكانه قبل خمس دقائق فقط من توقيت تسجيل خروجه رسميًا، وهو فارق غير معتاد في هذا السجل.","","من يملك حق الوصول إلى سجل المفاتيح ليعدّله بهذه الدقة؟"),new InvestigationRound(2,"الصفحة الفارغة","آلة النسخ في مكتب الكتابة أخرجت صفحة فارغة تحمل جزءًا من ختم القضية، ما يشير إلى أن أحدًا استخدمها بعد ساعات العمل الرسمية.","","من كان يعمل في مكتب الكتابة بعد انتهاء الدوام الرسمي؟"),new InvestigationRound(3,"الخيط الأزرق على النافذة","الخيط الأزرق العالق على إطار نافذة الممر يطابق نوع قماش يُستخدم في بدلات العمل الرسمية لبعض موظفي المحكمة، لا ملابس الزوار العاديين.","","من من موظفي المحكمة يرتدي بدلة بهذا اللون تحديدًا؟")}));
         stories.add(new Story("greenhouse", "ليلة في الدفيئة", "نبتة طبية نادرة سُرقت من دفيئة زجاجية مغلقة قبل إعلان اكتشافها للعالم.", 4, 12,
             new StoryIntroduction("داخل دفيئة زجاجية معزولة في حرم بحثي هادئ، تنمو نبتة طبية نادرة اكتُشفت بعد سنوات من البحث، ومن المقرر الإعلان عنها للعالم صباح الغد.","الليلة الأخيرة قبل الإعلان، والفريق كله متوتر ومتحمس، وكل من في الحرم يعرف قيمة هذا الاكتشاف.","في منتصف الليل عمل نظام الري رغم أن جدول السقي كان متوقفًا رسميًا، وبحلول الصباح كانت النبتة قد اختفت من أصيصها الزجاجي المغلق.","النبتة قد تحمل علاجًا لمرض مستعصٍ، وفقدانها يعني ضياع فرصة علمية قد لا تتكرر لعقود.","قبل ساعات الإعلان الرسمي، اكتشفوا من دخل الدفيئة ليلًا رغم إغلاقها المحكم."),
             new StoryCharacter[]{new StoryCharacter("داني","فني الري","أنت المسؤول الوحيد عن برمجة نظام الري الآلي داخل الدفيئة.","أنت من شغّل نظام الري يدويًا في منتصف الليل لتغطية صوت نقلك للنبتة من أصيصها.","تعرف أن جدول السقي المتوقف رسميًا لا يمكن أن يعمل من تلقاء نفسه دون تدخل يدوي مباشر.","كنت في غرفة التحكم بالري أراجع إعدادات الرطوبة للأصص الأخرى.","اجعل الجميع يظنون أن النظام عمل بسبب اختبار تلقائي روتيني للنظام.",true,"أخرج النبتة من الدفيئة قبل أن يلاحظ أحد أن أصيصها فارغ."),new StoryCharacter("وفاء","خبيرة السموم","تدرسين المركبات النادرة في النبتة لتحديد فوائدها العلاجية المحتملة.","طلبتِ من داني تغطيتك بتشغيل الري بينما تأخذين عينة كاملة من النبتة لبحث سري تنوين نشره بمفردك.","تعرفين أن الدائرة الرطبة التي ظهرت على طاولة بعيدة عن النافذة تطابق مكان وضعك للأصيص أثناء النقل.","كنت في مختبرك الخاص تراجعين نتائج التحاليل السابقة.","أنكري أي طلب سابق لداني بخصوص تشغيل نظام الري.",true,"احتفظي بالنبتة في مكان آمن حتى تنتهي من دراستك السرية عليها."),new StoryCharacter("رافي","مصور المجلة","حضرت الليلة لتوثيق الاكتشاف بالصور قبل الإعلان الرسمي صباح الغد.","ساعدت وفاء بإلهاء حارس الدفيئة لدقائق بحجة تجربة زاوية تصوير جديدة دون معرفة الخطة كاملة.","تعرف أن بصمة الراحة المغطاة بالتراب على زجاج الباب الخارجي تعود إلى داني بعد نقله النبتة مباشرة.","كنت أضبط إضاءة الكاميرا في الجانب الآخر من الدفيئة.","احمِ نفسك من تهمة التستر دون أن تكشف من طلب منك إلهاء الحارس.",true,"لا تذكر أنك رأيت داني بالقرب من الأصيص في ذلك التوقيت بالذات.")},
             new StoryCharacter[]{new StoryCharacter("نادية","عالمة النبات","قائدة فريق البحث التي اكتشفت النبتة بعد سنوات من العمل الدؤوب.","أخفيتِ عن الفريق أن جهة تجارية عرضت عليك مبلغًا ضخمًا لشراء حقوق النبتة قبل الإعلان الرسمي.","تعرفين أن فتح فتحة التهوية لمدة دقيقة واحدة يتطابق مع وقت كافٍ لإخراج أصيص بحجم النبتة.","كنت في مكتبك تراجعين خطاب الإعلان الرسمي المزمع صباح الغد.","أخفي عرض الجهة التجارية حتى لا يبدو الأمر وكأن له علاقة بالاختفاء.",false,""),new StoryCharacter("كامران","حارس الدفيئة","تراقب الدفيئة ليلًا وتتحقق من إغلاقها المحكم كل ساعة.","ابتعدت عن نقطة حراستك لدقائق قصيرة بناءً على طلب المصور لتجربة زاوية تصوير جديدة.","تعرف أن جولتك تأخرت قليلًا الليلة عن موعدها المعتاد بسبب هذا الإلهاء.","كنت أقوم بجولة التفتيش المعتادة حول محيط الدفيئة.","أخفِ سبب ابتعادك عن نقطتك حتى لا يُشكك أحد في التزامك.",false,""),new StoryCharacter("سلوى","خبيرة التربة","تراقبين تركيبة التربة الخاصة التي تحتاجها النبتة النادرة للنمو.","أخذتِ عينة صغيرة من تربة الأصيص لتحليلها الخاص قبل أسبوع دون تسجيل رسمي.","تعرفين أن التربة في الأصيص كانت مضطربة قليلًا حتى قبل اكتشاف الاختفاء صباحًا.","كنت في مختبر التربة المجاور تراجعين نتائج عينات أخرى.","أخفي عينتك السابقة حتى لا يبدو الأمر وكأنه اعتراف مبكر.",false,""),new StoryCharacter("إيلي","باحث السموم المساعد","يساعد وفاء في تحليل المركبات النادرة داخل النبتة.","اكتشفت خطأ في حسابات وفاء السابقة ولم تخبرها حتى لا تُحرجها أمام الفريق.","تعرف أن بعض نتائج وفاء المعلنة لا تتطابق تمامًا مع العينات الأصلية التي فحصتها بنفسك.","كنت تراجع ملاحظاتك الخاصة بعيدًا عن مختبر وفاء الرئيسي.","أخفِ شكوكك حول نتائج وفاء حتى تجد دليلًا أوضح.",false,""),new StoryCharacter("مايسة","مديرة الحرم البحثي","تديرين الميزانية والتصاريح الرسمية لكل مشاريع البحث في الحرم.","وافقتِ على زيارة ليلية غير معتادة لمسؤول تمويل خارجي دون إبلاغ فريق نادية بالكامل.","تعرفين أن المسؤول الخارجي كان قريبًا من الدفيئة في وقت غير معتاد لزيارته.","كنت في مكتبك الإداري تراجعين أوراق التمويل السنوية.","أخفي زيارة المسؤول الخارجي حتى لا تبدو وكأنها مرتبطة بالاختفاء.",false,""),new StoryCharacter("توني","فني الصيانة العام","يصلح أي عطل تقني في الحرم البحثي بما فيه أنظمة الدفيئة.","أخفيت عطلًا متكررًا في فتحة التهوية الآلية لتفادي تأخير جدول الصيانة الرسمي.","تعرف أن فتح فتحة التهوية لمدة دقيقة واحدة لا يتطابق مع نمط العطل المعتاد الذي كنت تخفيه.","كنت في ورشة الصيانة تراجع أدوات العمل استعدادًا لليوم التالي.","أخفِ عطل فتحة التهوية المزمن حتى تصلحه بنفسك بهدوء.",false,"")},
