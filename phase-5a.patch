+            new InvestigationRound[]{new InvestigationRound(1,"سجل تسليم الدعائم","سجل الدعائم يؤكد أن نسخة مقلدة من الخاتم سُلّمت قبل ساعة من موعدها المعتاد، وهذا خارج الإجراء القياسي المتبع في كل تصوير سابق.","","من يملك صلاحية تغيير موعد تسليم الدعائم عن الجدول المعتاد؟"),new InvestigationRound(2,"انعكاس اليد الغريبة","تحليل اللقطة الأخيرة يظهر أن الانعكاس الغريب يعود ليد ترتدي قفازًا رفيعًا من النوع الذي يستخدمه فريق الدعائم فقط أثناء التعامل مع القطع الثمينة.","","من في الطاقم يرتدي هذا النوع من القفازات أثناء العمل؟"),new InvestigationRound(3,"رمل من موقع خارجي","حبات الرمل الموجودة على منصة التصوير الداخلية تطابق نوع التربة في موقع تصوير خارجي زاره جزء صغير فقط من الطاقم اليوم.","","من غادر إلى الموقع الخارجي وعاد قبل اختفاء الخاتم مباشرة؟")}));
         stories.add(new Story("submarine", "نداء من الأعماق", "على متن غواصة علمية، اختفت شريحة بيانات من جهاز الملاحة قبل المرور عبر أخطر أخدود بحري.", 4, 12,
             new StoryIntroduction("على متن غواصة أبحاث علمية تغوص إلى أعماق قياسية، يستعد الطاقم للمرور عبر أخطر أخدود بحري مسجل، حيث الملاحة الدقيقة مسألة حياة أو موت.","الرحلة تقترب من نقطة اللاعودة قبل الأخدود، وكل فرد على متن الغواصة يعتمد على جهاز الملاحة نفسه للخروج بسلام.","توقف سجل السونار تسعين ثانية ثم عاد بإحداثيات معدّلة، واختفت شريحة بيانات كاملة من خزانة الملاحة رغم أنها لم تُكسر.","بدون الشريحة الأصلية قد تنحرف الغواصة عن مسارها داخل الأخدود، وهذا يعني خطرًا حقيقيًا على حياة الجميع تحت ضغط الأعماق.","قبل أن تصل الغواصة إلى نقطة الأخدود الحرجة، اكشفوا من عبث بالملاحة ولماذا."),
             new StoryCharacter[]{new StoryCharacter("طارق","ضابط الملاحة","أنت المسؤول الوحيد عن ضبط إحداثيات المسار داخل خزانة الملاحة المحكمة.","أنت من أخذ شريحة البيانات الأصلية واستبدلها بأخرى معدلة تخدم مسارًا مختلفًا.","تعرف أن خزانة الملاحة لا تحتاج كسرًا لفتحها إذا عرفت مكان المسمار الخلفي المفكوك.","كنت في غرفة الملاحة أراجع الإحداثيات طوال فترة توقف السونار.","اجعل الجميع يظنون أن ضغط الأعماق هو من أثّر على دقة السونار.",true,"احتفظ بالشريحة الأصلية مخفية حتى تتمكن من استخدامها بعد نهاية الرحلة."),new StoryCharacter("لينا","قائدة الغواصة","تملكين القرار النهائي في كل تغيير مسار أثناء الرحلة، وأنت من وافقت على الجدول الأصلي.","طلبتِ من طارق تعديل الإحداثيات لتفادي منطقة بحثية تنافسية دون علم بقية الطاقم.","تعرفين أن الأمر الصوتي المسجل الذي وصل من جسر القيادة لم يصدره النظام، لأنك من سجلتِه مسبقًا.","كنت في مقصورة القيادة أراقب الشاشات الرئيسية طوال الوقت.","أنكري أي طلب سابق لطارق بخصوص تعديل المسار.",true,"احمي الإحداثيات المعدلة حتى تمر الغواصة بأمان من المنطقة التي تريدينها."),new StoryCharacter("فارس","مهندس المحركات","تراقب أداء محركات الغواصة وتستجيب لأي طلب تغيير سرعة مفاجئ.","ساعدت لينا بتنفيذ تغيير السرعة المفاجئ الذي غطّى على وقت تعديل الملاحة دون أن تعرف السبب الكامل.","تعرف أن كوب القهوة الذي انسكب قرب لوحة التحكم سقط بسبب حركتك المفاجئة نحو خزانة الملاحة.","كنت في غرفة المحركات أراقب مؤشرات السرعة طوال فترة الحادث.","احمِ نفسك من تهمة التستر دون أن تكشف من طلب منك تغيير السرعة.",true,"لا تذكر أنك اقتربت من خزانة الملاحة في تلك اللحظة بالذات.")},
             new StoryCharacter[]{new StoryCharacter("هيثم","طبيب الرحلة","يراقب الحالة الصحية لطاقم الغواصة في ظروف الضغط العالي.","أعطيت طارق دواءً مهدئًا لتوتر مفاجئ قبل الحادث بوقت قصير دون أن تسأل عن السبب.","تعرف أن طارق بدا متوترًا بشكل غير معتاد في الساعة السابقة لتوقف السونار.","كنت في العيادة الصغيرة أراجع مخزون الأدوية استعدادًا لعبور الأخدود.","حافظ على سرية زيارة طارق الطبية حتى تعرف إن كانت مرتبطة بالحادث.",false,""),new StoryCharacter("مايا","باحثة الأحياء البحرية","تدرسين الكائنات النادرة التي تظهر فقط في أعماق هذا الأخدود.","طلبتِ تأخير المرور عبر الأخدود ساعة كاملة لالتقاط عينات إضافية دون علم القائدة رسميًا.","تعرفين أن طلبك بالتأخير رُفض رسميًا، لكن المسار تغيّر لاحقًا بطريقة تخدم منطقة بحثك تقريبًا.","كنت في مختبر العينات الصغير تراجعين تسجيلات المستشعرات الحيوية.","أخفي طلبك المرفوض حتى لا يبدو الأمر وكأن له علاقة بتغيير المسار.",false,""),new StoryCharacter("سامر","فني السونار","تشغّل جهاز السونار وتفسر إشاراته لحظة بلحظة أثناء الغوص.","أخفيت عطلًا متكررًا بسيطًا في معايرة السونار لتفادي تأخير الرحلة بفحص إضافي.","تعرف أن توقف السونار تسعين ثانية لا يتطابق مع نمط العطل المعتاد الذي كنت تخفيه.","كنت أمام شاشة السونار طوال الوقت عدا توقفها المفاجئ.","أخفِ عطل المعايرة المزمن حتى تصلحه بنفسك بعد نهاية الرحلة.",false,""),new StoryCharacter("ندى","ضابطة الاتصالات","تحافظين على خط الاتصال الوحيد بالسطح أثناء الغوص العميق.","أرسلتِ رسالة شخصية قصيرة للسطح خارج البروتوكول الرسمي لأسباب عائلية بحتة.","تعرفين أن الأمر الصوتي المسجل الذي ظهر في السجل لم يُرسل عبر جهازك رغم استخدامه نفس القناة.","كنت أمام لوحة الاتصال طوال فترة توقف السونار.","أخفي رسالتك الشخصية حتى لا تُخلطي بالأمر الصوتي المشبوه الآخر.",false,""),new StoryCharacter("عدنان","مساعد الملاحة","يساعد طارق في تسجيل الإحداثيات ومراجعتها قبل كل تعديل مسار.","وقّعت على تعديل إحداثيات دون مراجعته كاملًا لأنك كنت متعبًا من نوبة طويلة.","تعرف أن التوقيع المطلوب على أي تعديل ملاحة يحتاج شخصين، وأنت أحدهما رغم أنك لم تراجع التعديل جيدًا.","كنت أراجع سجلات المسار السابقة في الطرف الآخر من غرفة الملاح