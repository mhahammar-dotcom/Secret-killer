+            new InvestigationRound[]{new InvestigationRound(1,"قفل العربة الرابعة","سجل النظام الإلكتروني يؤكد أن باب العربة الرابعة أُغلق مجددًا تلقائيًا بعد فتحه، ما يعني أن من فتحه كان يعرف كيف يعيد إغلاقه بسرعة.","","من يملك خبرة كافية بنظام الأبواب ليعيد إغلاقه دون أن يلاحظ أحد؟"),new InvestigationRound(2,"انقطاع الاتصالات","غرفة الاتصالات تؤكد أن الانقطاع التسعين ثانية طال فقط خط التواصل مع المحطة القادمة، ولم يؤثر على أي نظام آخر في القطار.","","من كان بحاجة إلى قطع الاتصال بالتحديد في تلك اللحظة؟"),new InvestigationRound(3,"التذكرة المزورة","التذكرة التي حملت اسمًا مستعارًا صدرت من جهاز بيع متنقل واحد، ولم تُسجَّل في القائمة الرسمية لصعود الركاب.","","من يملك صلاحية إصدار تذاكر من جهازه الخاص دون تسجيلها فورًا؟")}));
         stories.add(new Story("observatory", "مرصد النجم الساقط", "في ليلة رصد نادرة، اختفت عينة نيزكية من قبة المرصد وانطفأت أجهزة التتبع في اللحظة نفسها.", 4, 12,
             new StoryIntroduction("فوق تلة معزولة بعيدة عن أضواء المدينة، يقف مرصد قديم استعد طوال العام لرصد نيزك نادر يمر مرة كل قرن.","الفريق كله مجتمع الليلة نفسها، متحمس ومتوتر، وكل ثانية في الجدول محسوبة بدقة قبل عبور النيزك.","قبل دقيقة واحدة من موعد الرصد الرسمي فُتحت القبة مبكرًا، واختفت عينة نيزكية نادرة من الخزنة بينما انطفأت أجهزة التتبع للحظات.","العينة لا تُقدَّر بثمن علميًا، وموعد المرور لن يتكرر قبل مئة عام أخرى — كل دقيقة نقاش تُبعدكم عن استعادتها.","قبل شروق الشمس وانتهاء نافذة الرصد إلى الأبد، اكتشفوا من عبث بالقبة والساعة الذرية في الوقت نفسه."),
             new StoryCharacter[]{new StoryCharacter("بشار","مبرمج نظام التتبع","من كتب برنامج التتبع الآلي للقبة والساعة الذرية معًا.","أنت من فتح القبة قبل الموعد المحدد لتأخذ العينة قبل أن يراها أحد آخر.","تعرف كيف تُخفي فارق ثوانٍ في الساعة الذرية دون أن يلاحظه أحد غيرك.","كنت أراقب شاشة التتبع من غرفة البرمجة المجاورة.","اجعل الجميع يظنون أن تأخر الساعة الذرية سبب تقني بحت لا علاقة له بالسرقة.",true,"أخرج العينة من المرصد قبل أن يُكتشف التلاعب بتوقيت الساعة الذرية."),new StoryCharacter("نور","زائرة من مرصد منافس","حضرتِ الليلة كضيفة علمية من مرصد شريك لمتابعة الرصد التاريخي.","جئتِ فعليًا لتأخذي العينة لصالح مرصدك الأصلي الذي خسر التمويل بسبب هذا الاكتشاف.","تعرفين أن جهاز الاستغاثة أرسل إشارة قصيرة قبل أن تُحذف، لأنك من حاول حذفها.","كنت أراقب الرصد من الشرفة الخارجية مع بقية الضيوف.","أنكري أي صلة سابقة بين مرصدك ومرصد هذا الفريق.",true,"احذفي أي أثر رقمي لإشارة الاستغاثة قبل أن يفحصها أحد بعناية."),new StoryCharacter("وائل","سائق الإمدادات الليلي","تنقل معدات الصيانة والإمدادات إلى المرصد المعزول مرة أسبوعيًا.","ساعدت نور بإدخالها من باب الإمدادات الجانبي دون تسجيل زيارتها رسميًا.","تعرف أن غبار العينة النيزكية علق بمقبض غرفة لا يدخلها إلا فريق الصيانة، لأنك دخلتها معها.","كنت أفرغ صناديق المعدات عند الباب الخلفي طوال الوقت.","احمِ نفسك من تهمة تسهيل الدخول غير المصرح به.",true,"أنكر أنك أدخلت أي شخص من باب الإمدادات الليلة.")},
             new StoryCharacter[]{new StoryCharacter("منال","عالمة الفلك","قائدة فريق الرصد ومن حصلت على تمويل المشروع بأكمله.","أخفيتِ عن الفريق أن التمويل مهدد بالتوقف إذا فشل رصد الليلة.","تعرفين أن فتح القبة المبكر يحتاج تصريحًا منك شخصيًا، ولم تمنحيه لأحد.","كنت في غرفة التحكم الرئيسية أراجع إحداثيات الرصد الأخيرة.","أخفي أزمة التمويل عن الفريق حتى ينتهي الرصد بنجاح.",false,""),new StoryCharacter("عادل","فني التلسكوب","تضبط زاوية التلسكوب يدويًا في اللحظات الحرجة قبل الرصد.","أخطأت في ضبط زاوية أولية قبل الحادث بدقائق، وتخشى أن يُلام على تأخر الرصد.","تعرف أن القبة تحتاج لثوانٍ معدودة فقط لتُفتح يدويًا من الداخل، وهذا يستبعد الكثيرين.","كنت أضبط محرك القبة الميكانيكي في اللحظة السابقة للحادث.","أخفِ خطأك في الضبط حتى لا يبدو وكأنه سبب الفوضى.",false,""),new StoryCharacter("سامية","خبيرة الأرصاد","تراقبين حالة الطقس لتحديد أفضل نافذة للرصد الليلة.","توقعتِ عاصفة غبار خفيفة ولم تخبري أحدًا حتى لا يُلغى الرصد بسببك.","تعرفين أن الغبار الذي وُجد على مقبض غرفة الصيانة قد يكون من العاصفة الخفيفة لا من أثر بشري.","كنت أراقب أجهزة الطقس في الطابق السفلي من المرصد.","أثبتي أن تنبؤك كان دقيقًا دون أن تتحملي مسؤولية إخفائه.",false,""),new StoryCharacter("هالة","حارسة المرصد","مسؤولة عن أمن المبنى وجولات التفتيش الليلية.","تركتِ باب الصيانة الجانبي دون قفل لبضع دقائق لتدخين سيجارة سريعة.","تعرفين أن جولتك تأخرت قليلًا الليلة عن موعدها المعتاد.","كنت أقوم بجولة التفتيش المعتادة حول محيط المبنى.","أخفي تأخر جولتك حتى لا يُشكك أحد في التزامك.",false,""),new StoryCharacter("كنان","طالب الدراسات العليا","يساعد في تسجيل بيانات الرصد كجزء من رسالته العلمية.","نسخت جزءًا من بيانات العينة سرًا لاستخدامها في بحثك الخاص دون إذن رسمي.","تعرف أن أحدًا دخل قاعة البيانات بعد منتصف الليل بقليل، لأنك كنت هناك أيضًا.","كنت أدوّن الأرقام الأولية في دفتر ملاحظاتي الخاص.","أخفِ نسخك غير المصرح به للبيانات حتى تنتهي من بحثك.",false,""),new StoryCharacter("ياسمين","مصورة السماء","توثق لحظة الرصد التاريخية بكاميرات بعيدة المدى.","التقطتِ صورة عرضية للقبة وهي تُفتح قبل الموعد الرسمي بدقيقة.","تعرفين أن ظلًا سريعًا مرّ أمام عدستك في نفس لحظة انطفاء أجهزة التتبع.","كنت في الشرفة العلوية أضبط بعد العدسة على النيزك القادم.","لا تُظهري صورتك لأحد قبل أن تفهمي ما التقطته فعلًا.",false,"")},
             new Clue[]{new Clue("سجل القبة يثبت أنها فُتحت قبل دقيقة من موعد الرصد الرسمي."),new Clue("وصلت إشارة استغاثة قصيرة من جهاز التتبع ثم حُذفت من السجل."),new Clue("وُجد غبار نيزكي على مقبض غرفة لا يدخلها إلا فريق الصيانة."),new Clue("الساعة الذرية في المرصد تأخرت سبع عشرة ثانية دون تفسير.")},
