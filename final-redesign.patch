-            new InvestigationRound[]{new InvestigationRound(1,"تشغيل الري غير المجدول","سجل نظام الري يؤكد أن تشغيله في منتصف الليل تم يدويًا من لوحة التحكم، وليس نتيجة اختبار تلقائي كما يُشاع عادة.","","من يعرف كيفية تشغيل نظام الري يدويًا وتجاوز الجدول المتوقف؟"),new InvestigationRound(2,"الدائرة الرطبة الغريبة","الدائرة الرطبة الموجودة على طاولة بعيدة عن أي نافذة تتطابق تمامًا مع حجم أصيص النبتة المفقودة، ما يعني أنه وُضع هناك مؤقتًا أثناء نقله.","","من كان يحتاج لمكان مؤقت لوضع الأصيص قبل إخراجه من الدفيئة؟"),new InvestigationRound(3,"بصمة الراحة على الزجاج","بصمة الراحة المغطاة بالتراب على زجاج الباب الخارجي تشير إلى أن شخصًا خرج من الدفيئة وهو يحمل شيئًا بكلتا يديه، مستخدمًا كتفه أو مرفقه لدفع الباب.","","من كان يحمل شيئًا كبيرًا بكلتا يديه في ذلك الوقت من الليل؟")}));
+            new InvestigationRound[]{new InvestigationRound(1,"تشغيل الري غير المجدول","سجل نظام الري يؤكد أن تشغيله في منتصف الليل تم يدويًا من لوحة التحكم، وليس نتيجة اختبار تلقائي كما يُشاع عادة.","","من يعرف كيفية تشغيل نظام الري يدويًا وتجاوز الجدول المتوقف؟"),new InvestigationRound(2,"الدائرة الرطبة الغريبة","الدائرة الرطبة الموجودة على طاولة بعيدة عن أي نافذة تتطابق تمامًا مع حجم أصيص النبتة المفقودة، ما يعني أنه وُضع هناك مؤقتًا أثناء نقله.","","من كان يحتاج لمكان مؤقت لوضع الأصيص قبل إخراجه من الدفيئة؟"),new InvestigationRound(3,"بصمة الراحة على الزجاج","بصمة الراحة المغطاة بالتراب على زجاج الباب الخارجي تشير إلى أن شخصًا خرج من الدفيئة وهو يحمل شيئًا بكلتا يديه، مستخدمًا كتفه أو مرفقه لدفع الباب.","","من كان يحمل شيئًا كبيرًا بكلتا يديه في ذلك الوقت من الليل؟")},
+            "من الفاعل؟\nداني، فني الري، هو من نقل النبتة النادرة من الدفيئة.\n\nماذا فعل؟\nشغّل نظام الري يدويًا في منتصف الليل ليغطي صوت نقله للنبتة من أصيصها، رغم أن جدول السقي كان متوقفًا رسميًا.\n\nكيف حدثت الجريمة؟\nطلبت منه وفاء (خبيرة السموم) تغطيته أثناء أخذها عينة كاملة من النبتة لبحث سري تخطط لنشره بمفردها، بينما ألهى رافي (مصور المجلة) حارس الدفيئة لدقائق بحجة تجربة زاوية تصوير جديدة.\n\nأي الأدلة أشارت إليه؟\nتشغيل الري في وقت غير مجدول يحتاج تدخلًا يدويًا مباشرًا، وبصمة راحة مغطاة بالتراب على زجاج الباب الخارجي تشير إلى شخص كان يحمل شيئًا بكلتا يديه.\n\nكيف ساعدت المعرفة الخاصة بكل شخصية؟\nمعرفة كامران (حارس الدفيئة) بتأخر جولته بسبب إلهاء غير معتاد كشفت نافذة زمنية للحادث، ومعرفة توني (فني الصيانة) بأن عطل فتحة التهوية المعتاد لا يشبه ما حدث الليلة استبعدت فرضية العطل التقني."));
         stories.add(new Story("royal_kitchen", "وليمة القصر", "أثناء وليمة في قصر تاريخي، اختفت رسالة مختومة من صينية الحلوى قبل أن تصل إلى الضيوف.", 4, 12,
             new StoryIntroduction("في قصر تاريخي يستضيف وليمة كبرى لعائلة نبيلة، تُحضَّر أطباق الحلوى الفاخرة في مطبخ ضخم يعج بالطهاة والخدم قبل تقديمها للضيوف.","الوليمة في ذروتها، ورسالة سرية مختومة أُخفيت داخل صينية الحلوى لتصل إلى شخص محدد بين الضيوف دون علم البقية.","قبل أن تصل الصينية إلى القاعة، استُبدلت بصينية مطابقة تمامًا، واختفت الرسالة المختومة، بينما ظهر ختمها مطبوعًا على قطعة سكر مكسورة في المطبخ.","الرسالة تحمل سرًا عائليًا قد يقلب موازين الوليمة بأكملها إن وقعت في الأيدي الخطأ أمام كل الضيوف.","قبل أن تنتهي الوليمة ويغادر الضيوف، اكتشفوا من بين طاقم المطبخ والخدم استبدل الصينية الأصلية."),
